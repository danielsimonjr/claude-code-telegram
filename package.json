{
  "name": "claude-code-telegram",
  "version": "1.0.1",
  "description": "Control Claude Code from Telegram. No tunnels, no Docker, no cloud hosting.",
  "main": "dist/index.js",
  "bin": {
    "claude-telegram": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "bash setup.sh",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "telegram",
    "bot",
    "bridge",
    "tmux",
    "ai",
    "coding-assistant"
  ],
  "author": "Daniel Simon Jr. <Daniel@danielsimonjr.com>",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "grammy": "^1.46.0"
  },
  "files": [
    "dist",
    "setup.sh",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
